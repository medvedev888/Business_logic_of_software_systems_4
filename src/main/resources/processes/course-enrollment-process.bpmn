<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_CourseEnrollmentLab4" targetNamespace="http://ifmo.me/blps/lab4/course-enrollment" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.28.0">
  <bpmn:message id="Message_PaymentResult" name="PAYMENT_RESULT"/>
  <bpmn:collaboration id="Collaboration_CourseEnrollment">
    <bpmn:participant id="Participant_MainApplication" name="Main application" processRef="course-enrollment-process"/>
    <bpmn:participant id="Participant_PaymentProvider" name="Payment Provider"/>
    <bpmn:messageFlow id="MessageFlow_CreatePayment" name="HTTP: create payment" sourceRef="Task_CreatePayment" targetRef="Participant_PaymentProvider"/>
    <bpmn:messageFlow id="MessageFlow_PaymentResult" name="Webhook: PAID / FAILED" sourceRef="Participant_PaymentProvider" targetRef="Event_PaymentResult"/>
  </bpmn:collaboration>
  <bpmn:process id="course-enrollment-process" name="Course Enrollment and Payment" isExecutable="true" camunda:historyTimeToLive="180" camunda:isStartableInTasklist="true">
    <bpmn:startEvent id="StartEvent_Enrollment" name="Начать запись на курс" camunda:initiator="initiator">
      <bpmn:outgoing>Flow_Start_Request</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask_EnrollmentRequest" name="Подать заявку на запись" camunda:assignee="${initiator}">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="requestType" label="Тип записи" type="enum" defaultValue="SELF">
            <camunda:value id="SELF" name="Записать себя"/>
            <camunda:value id="ADMIN_FOR_USER" name="Записать другого пользователя (ADMIN)"/>
          </camunda:formField>
          <camunda:formField id="courseId" label="ID курса" type="long"/>
          <camunda:formField id="targetUserId" label="ID пользователя (только для ADMIN_FOR_USER)" type="long"/>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Request</bpmn:incoming>
      <bpmn:outgoing>Flow_Request_RequestType</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_RequestType" name="Тип записи?">
      <bpmn:incoming>Flow_Request_RequestType</bpmn:incoming>
      <bpmn:outgoing>Flow_RequestType_Self</bpmn:outgoing>
      <bpmn:outgoing>Flow_RequestType_Admin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_AuthorizeSelf" name="Проверить ENROLLMENT_CREATE" camunda:delegateExpression="${authorizeSelfEnrollmentDelegate}">
      <bpmn:incoming>Flow_RequestType_Self</bpmn:incoming>
      <bpmn:outgoing>Flow_SelfAuth_Merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AuthorizeAdmin" name="Проверить ENROLLMENT_CREATE_ALL" camunda:delegateExpression="${authorizeAdminEnrollmentDelegate}">
      <bpmn:incoming>Flow_RequestType_Admin</bpmn:incoming>
      <bpmn:outgoing>Flow_AdminAuth_Merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_AuthorizationMerge">
      <bpmn:incoming>Flow_SelfAuth_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_AdminAuth_Merge</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_CheckCourse</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CheckCourse" name="Проверить доступность курса" camunda:delegateExpression="${checkCourseAvailabilityDelegate}">
      <bpmn:incoming>Flow_Merge_CheckCourse</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckCourse_Availability</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_CourseAvailable" name="Курс доступен?" default="Flow_CourseUnavailable">
      <bpmn:incoming>Flow_CheckCourse_Availability</bpmn:incoming>
      <bpmn:outgoing>Flow_CourseAvailable</bpmn:outgoing>
      <bpmn:outgoing>Flow_CourseUnavailable</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_CourseUnavailable" name="Запись отклонена: курс недоступен">
      <bpmn:incoming>Flow_CourseUnavailable</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_CreateEnrollment" name="Создать Enrollment (PENDING_PAYMENT)" camunda:delegateExpression="${createEnrollmentDelegate}">
      <bpmn:incoming>Flow_CourseAvailable</bpmn:incoming>
      <bpmn:outgoing>Flow_CreateEnrollment_UserPayment</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask_CreatePayment" name="Создать платёж" camunda:assignee="${initiator}">
      <bpmn:incoming>Flow_CreateEnrollment_UserPayment</bpmn:incoming>
      <bpmn:outgoing>Flow_UserPayment_AuthorizePayment</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_AuthorizePaymentCreation" name="Проверить PAYMENT_CREATE" camunda:delegateExpression="${authorizePaymentCreationDelegate}">
      <bpmn:incoming>Flow_UserPayment_AuthorizePayment</bpmn:incoming>
      <bpmn:outgoing>Flow_AuthorizePayment_CreatePayment</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CreatePayment" name="Создать Payment у провайдера" camunda:delegateExpression="${createPaymentDelegate}">
      <bpmn:incoming>Flow_AuthorizePayment_CreatePayment</bpmn:incoming>
      <bpmn:outgoing>Flow_CreatePayment_Wait</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="Gateway_WaitPayment" name="Ждать результат оплаты или проверку срока">
      <bpmn:incoming>Flow_CreatePayment_Wait</bpmn:incoming>
      <bpmn:incoming>Flow_NotExpired_WaitAgain</bpmn:incoming>
      <bpmn:outgoing>Flow_Wait_Message</bpmn:outgoing>
      <bpmn:outgoing>Flow_Wait_Timer</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_PaymentResult" name="Получен webhook PAYMENT_RESULT">
      <bpmn:incoming>Flow_Wait_Message</bpmn:incoming>
      <bpmn:outgoing>Flow_Message_Status</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_PaymentResult" messageRef="Message_PaymentResult"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_PaymentStatus" name="Статус оплаты?">
      <bpmn:incoming>Flow_Message_Status</bpmn:incoming>
      <bpmn:outgoing>Flow_Status_Paid</bpmn:outgoing>
      <bpmn:outgoing>Flow_Status_Failed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_PaymentPaid" name="PAID: активировать запись и списать место" camunda:delegateExpression="${completePaidPaymentDelegate}">
      <bpmn:incoming>Flow_Status_Paid</bpmn:incoming>
      <bpmn:outgoing>Flow_Paid_ActiveEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Active" name="Enrollment ACTIVE">
      <bpmn:incoming>Flow_Paid_ActiveEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_PaymentFailed" name="FAILED: отметить платёж и запись" camunda:delegateExpression="${completeFailedPaymentDelegate}">
      <bpmn:incoming>Flow_Status_Failed</bpmn:incoming>
      <bpmn:outgoing>Flow_Failed_FailedEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_PaymentFailed" name="Enrollment PAYMENT_FAILED">
      <bpmn:incoming>Flow_Failed_FailedEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Event_ExpirationCheckTimer" name="Каждые 60 секунд">
      <bpmn:incoming>Flow_Wait_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_Timer_CheckExpired</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_ExpirationCheck">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT60S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_CheckPaymentExpired" name="Проверить срок платежа" camunda:delegateExpression="${checkPaymentExpiredDelegate}">
      <bpmn:incoming>Flow_Timer_CheckExpired</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckExpired_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_PaymentExpired" name="Платёж просрочен?" default="Flow_NotExpired_WaitAgain">
      <bpmn:incoming>Flow_CheckExpired_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Expired_Expire</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotExpired_WaitAgain</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ExpirePayment" name="EXPIRED: обновить Payment и Enrollment" camunda:delegateExpression="${expirePaymentDelegate}">
      <bpmn:incoming>Flow_Expired_Expire</bpmn:incoming>
      <bpmn:outgoing>Flow_Expire_ExpiredEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Expired" name="Enrollment PAYMENT_EXPIRED">
      <bpmn:incoming>Flow_Expire_ExpiredEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_CreateEnrollment_UserPayment" sourceRef="Task_CreateEnrollment" targetRef="UserTask_CreatePayment"/>
    <bpmn:sequenceFlow id="Flow_UserPayment_AuthorizePayment" sourceRef="UserTask_CreatePayment" targetRef="Task_AuthorizePaymentCreation"/>
    <bpmn:sequenceFlow id="Flow_AuthorizePayment_CreatePayment" sourceRef="Task_AuthorizePaymentCreation" targetRef="Task_CreatePayment"/>
    <bpmn:sequenceFlow id="Flow_Start_Request" sourceRef="StartEvent_Enrollment" targetRef="UserTask_EnrollmentRequest"/>
    <bpmn:sequenceFlow id="Flow_Request_RequestType" sourceRef="UserTask_EnrollmentRequest" targetRef="Gateway_RequestType"/>
    <bpmn:sequenceFlow id="Flow_RequestType_Self" name="SELF" sourceRef="Gateway_RequestType" targetRef="Task_AuthorizeSelf">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
            ${requestType == 'SELF'}
        </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RequestType_Admin" name="ADMIN_FOR_USER" sourceRef="Gateway_RequestType" targetRef="Task_AuthorizeAdmin">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
            ${requestType == 'ADMIN_FOR_USER'}
        </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SelfAuth_Merge" sourceRef="Task_AuthorizeSelf" targetRef="Gateway_AuthorizationMerge"/>
    <bpmn:sequenceFlow id="Flow_AdminAuth_Merge" sourceRef="Task_AuthorizeAdmin" targetRef="Gateway_AuthorizationMerge"/>
    <bpmn:sequenceFlow id="Flow_Merge_CheckCourse" sourceRef="Gateway_AuthorizationMerge" targetRef="Task_CheckCourse"/>
    <bpmn:sequenceFlow id="Flow_CheckCourse_Availability" sourceRef="Task_CheckCourse" targetRef="Gateway_CourseAvailable"/>
    <bpmn:sequenceFlow id="Flow_CourseAvailable" name="да" sourceRef="Gateway_CourseAvailable" targetRef="Task_CreateEnrollment">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
            ${courseAvailable == true}
        </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CourseUnavailable" name="нет" sourceRef="Gateway_CourseAvailable" targetRef="EndEvent_CourseUnavailable"/>
    <bpmn:sequenceFlow id="Flow_CreatePayment_Wait" sourceRef="Task_CreatePayment" targetRef="Gateway_WaitPayment"/>
    <bpmn:sequenceFlow id="Flow_NotExpired_WaitAgain" name="нет" sourceRef="Gateway_PaymentExpired" targetRef="Gateway_WaitPayment"/>
    <bpmn:sequenceFlow id="Flow_Wait_Message" sourceRef="Gateway_WaitPayment" targetRef="Event_PaymentResult"/>
    <bpmn:sequenceFlow id="Flow_Wait_Timer" sourceRef="Gateway_WaitPayment" targetRef="Event_ExpirationCheckTimer"/>
    <bpmn:sequenceFlow id="Flow_Message_Status" sourceRef="Event_PaymentResult" targetRef="Gateway_PaymentStatus"/>
    <bpmn:sequenceFlow id="Flow_Status_Paid" name="PAID" sourceRef="Gateway_PaymentStatus" targetRef="Task_PaymentPaid">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
            ${paymentStatus == 'PAID'}
        </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Status_Failed" name="FAILED" sourceRef="Gateway_PaymentStatus" targetRef="Task_PaymentFailed">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
            ${paymentStatus == 'FAILED'}
        </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Paid_ActiveEnd" sourceRef="Task_PaymentPaid" targetRef="EndEvent_Active"/>
    <bpmn:sequenceFlow id="Flow_Failed_FailedEnd" sourceRef="Task_PaymentFailed" targetRef="EndEvent_PaymentFailed"/>
    <bpmn:sequenceFlow id="Flow_Timer_CheckExpired" sourceRef="Event_ExpirationCheckTimer" targetRef="Task_CheckPaymentExpired"/>
    <bpmn:sequenceFlow id="Flow_CheckExpired_Gateway" sourceRef="Task_CheckPaymentExpired" targetRef="Gateway_PaymentExpired"/>
    <bpmn:sequenceFlow id="Flow_Expired_Expire" name="да" sourceRef="Gateway_PaymentExpired" targetRef="Task_ExpirePayment">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">
            ${paymentExpired == true}
        </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Expire_ExpiredEnd" sourceRef="Task_ExpirePayment" targetRef="EndEvent_Expired"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_CourseEnrollment">
    <bpmndi:BPMNPlane id="BPMNPlane_CourseEnrollment" bpmnElement="Collaboration_CourseEnrollment">
      <bpmndi:BPMNShape id="Participant_MainApplication_di" bpmnElement="Participant_MainApplication" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2550" height="430"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Enrollment_di" bpmnElement="StartEvent_Enrollment">
        <dc:Bounds x="220" y="277" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="194" y="313" width="89" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_EnrollmentRequest_di" bpmnElement="UserTask_EnrollmentRequest">
        <dc:Bounds x="290" y="255" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RequestType_di" bpmnElement="Gateway_RequestType" isMarkerVisible="true">
        <dc:Bounds x="480" y="270" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="475" y="320" width="63" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AuthorizeSelf_di" bpmnElement="Task_AuthorizeSelf">
        <dc:Bounds x="570" y="170" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AuthorizeAdmin_di" bpmnElement="Task_AuthorizeAdmin">
        <dc:Bounds x="570" y="340" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AuthorizationMerge_di" bpmnElement="Gateway_AuthorizationMerge" isMarkerVisible="true">
        <dc:Bounds x="770" y="270" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckCourse_di" bpmnElement="Task_CheckCourse">
        <dc:Bounds x="860" y="255" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CourseAvailable_di" bpmnElement="Gateway_CourseAvailable" isMarkerVisible="true">
        <dc:Bounds x="1050" y="270" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1035" y="320" width="80" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_CourseUnavailable_di" bpmnElement="EndEvent_CourseUnavailable">
        <dc:Bounds x="1145" y="137" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1123" y="173" width="81" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateEnrollment_di" bpmnElement="Task_CreateEnrollment">
        <dc:Bounds x="1140" y="255" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreatePayment_di" bpmnElement="Task_CreatePayment">
        <dc:Bounds x="1740" y="255" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_WaitPayment_di" bpmnElement="Gateway_WaitPayment">
        <dc:Bounds x="1950" y="270" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1927" y="330" width="86" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_PaymentResult_di" bpmnElement="Event_PaymentResult">
        <dc:Bounds x="2050" y="177" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2024" y="213" width="89" height="53"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PaymentStatus_di" bpmnElement="Gateway_PaymentStatus" isMarkerVisible="true">
        <dc:Bounds x="2140" y="170" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2124" y="220" width="82" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PaymentPaid_di" bpmnElement="Task_PaymentPaid">
        <dc:Bounds x="2240" y="105" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Active_di" bpmnElement="EndEvent_Active">
        <dc:Bounds x="2490" y="127" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2482" y="163" width="53" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PaymentFailed_di" bpmnElement="Task_PaymentFailed">
        <dc:Bounds x="2240" y="225" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_PaymentFailed_di" bpmnElement="EndEvent_PaymentFailed">
        <dc:Bounds x="2490" y="247" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2468" y="283" width="81" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_ExpirationCheckTimer_di" bpmnElement="Event_ExpirationCheckTimer">
        <dc:Bounds x="2050" y="377" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2040" y="413" width="56" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckPaymentExpired_di" bpmnElement="Task_CheckPaymentExpired">
        <dc:Bounds x="2140" y="355" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PaymentExpired_di" bpmnElement="Gateway_PaymentExpired" isMarkerVisible="true">
        <dc:Bounds x="2330" y="370" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2325" y="420" width="60" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ExpirePayment_di" bpmnElement="Task_ExpirePayment">
        <dc:Bounds x="2430" y="355" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Expired_di" bpmnElement="EndEvent_Expired">
        <dc:Bounds x="2640" y="377" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2617" y="413" width="83" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_CreatePayment_di" bpmnElement="UserTask_CreatePayment">
        <dc:Bounds x="1350" y="255" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AuthorizePaymentCreation_di" bpmnElement="Task_AuthorizePaymentCreation">
        <dc:Bounds x="1540" y="255" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Request_di" bpmnElement="Flow_Start_Request">
        <di:waypoint x="256" y="295"/>
        <di:waypoint x="290" y="295"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Request_RequestType_di" bpmnElement="Flow_Request_RequestType">
        <di:waypoint x="440" y="295"/>
        <di:waypoint x="480" y="295"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RequestType_Self_di" bpmnElement="Flow_RequestType_Self">
        <di:waypoint x="505" y="270"/>
        <di:waypoint x="505" y="210"/>
        <di:waypoint x="570" y="210"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="515" y="233" width="31" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RequestType_Admin_di" bpmnElement="Flow_RequestType_Admin">
        <di:waypoint x="505" y="320"/>
        <di:waypoint x="505" y="380"/>
        <di:waypoint x="570" y="380"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="512" y="353" width="36" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SelfAuth_Merge_di" bpmnElement="Flow_SelfAuth_Merge">
        <di:waypoint x="730" y="210"/>
        <di:waypoint x="795" y="210"/>
        <di:waypoint x="795" y="270"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AdminAuth_Merge_di" bpmnElement="Flow_AdminAuth_Merge">
        <di:waypoint x="730" y="380"/>
        <di:waypoint x="795" y="380"/>
        <di:waypoint x="795" y="320"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Merge_CheckCourse_di" bpmnElement="Flow_Merge_CheckCourse">
        <di:waypoint x="820" y="295"/>
        <di:waypoint x="860" y="295"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CheckCourse_Availability_di" bpmnElement="Flow_CheckCourse_Availability">
        <di:waypoint x="1010" y="295"/>
        <di:waypoint x="1050" y="295"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CourseAvailable_di" bpmnElement="Flow_CourseAvailable">
